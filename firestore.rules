  match /friendProfiles/{uid} {
    allow get: if signedIn() && (request.auth.uid == uid || isAcceptedFriend(request.auth.uid, uid));
    allow list: if false;
    allow create: if owner(uid) && validFriendProfile(request.resource.data, uid);
    allow update: if owner(uid) && validFriendProfile(request.resource.data, uid)
      && sameOwnerUid()
      && sameContract()
      && sameCreatedAt()
      && advancesUpdatedAt();
    allow delete: if false;
  }
  match /socialProfiles/{uid} {
    allow get: if signedIn() && (request.auth.uid == uid || projectedFriends(request.auth.uid, uid))
      || (moderator() && exists(/databases/$(database)/documents/moderationTargetAuthorizations/profile/owners/$(uid)));
    allow list: if false;
    allow create: if owner(uid) && canPublishSocial(uid)
      && validSocialProfile(request.resource.data, uid);
    allow update: if owner(uid) && canPublishSocial(uid)
      && validSocialProfile(request.resource.data, uid)
