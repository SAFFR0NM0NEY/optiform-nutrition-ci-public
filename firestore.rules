        && validChallengeEntry(request.resource.data, challengeId, entryId,
          get(/databases/$(database)/documents/challenges/$(challengeId)).data);
      allow update, delete: if false;
    }
  }

  match /competitionTeams/{teamId} {
    allow get, list: if signedIn() && request.auth.uid in resource.data.participantUids;
    allow create: if signedIn() && validPendingTeam(request.resource.data, teamId)
      && request.resource.data.ownerUid == request.auth.uid
      && projectedFriends(request.resource.data.ownerUid, request.resource.data.teammateUid)
      && get(/databases/$(database)/documents/friendProfiles/$(request.resource.data.ownerUid)).data.displayName == request.resource.data.ownerDisplayName
      && get(/databases/$(database)/documents/friendProfiles/$(request.resource.data.teammateUid)).data.displayName == request.resource.data.teammateDisplayName;
    allow update: if signedIn() && request.auth.uid in resource.data.participantUids
      && validTeamTransition(resource.data, request.resource.data, teamId);
