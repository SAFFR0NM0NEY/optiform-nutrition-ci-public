    match /entries/{entryId} {
      allow get, list: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/competitionSeasons/$(seasonId)).data.participantUids;
      allow create: if signedIn()
        && validSeasonEntry(request.resource.data, seasonId, entryId,
          get(/databases/$(database)/documents/competitionSeasons/$(seasonId)).data);
      allow update, delete: if false;
    }
  }

  function validCreatorId(id) { return id is string && id.matches('^[0-9A-HJKMNP-TV-Z]{16}$'); }
  function validCreatorText(value, min, max) {
    return value is string && value.size() >= min && value.size() <= max
      && !value.matches('.*[<>].*');
  }
  function validCreatorSocialLink(link) {
    return link is map && link.keys().hasOnly(['provider', 'url'])
      && link.provider in ['instagram', 'youtube', 'tiktok', 'website']
      && link.url is string && link.url.size() <= 300
      && link.url.matches('^https://[^@\\s]+$');
  }
  function validCreatorSocialLinks(links) {
    return links is list && links.size() <= 4
      && (links.size() < 1 || validCreatorSocialLink(links[0]))
      && (links.size() < 2 || validCreatorSocialLink(links[1]))
      && (links.size() < 3 || validCreatorSocialLink(links[2]))
      && (links.size() < 4 || validCreatorSocialLink(links[3]));
  }
  function validCreatorAccount(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'creatorId', 'status', 'createdAt', 'updatedAt'])
      && validV1(data, 'creator-mode-v1')
      && data.ownerUid == uid && validCreatorId(data.creatorId)
      && data.status in ['active', 'paused'] && validTimestamps(data);
  }
  function validCreatorControl(data, creatorId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'creatorId', 'ownerUid', 'createdAt', 'updatedAt'])
      && validV1(data, 'creator-mode-v1')
      && data.creatorId == creatorId && validCreatorId(creatorId) && data.ownerUid is string
      && validTimestamps(data);
  }
  function creatorOwner(creatorId) {
    return signedIn() && exists(/databases/$(database)/documents/creatorPublicControls/$(creatorId))
      && get(/databases/$(database)/documents/creatorPublicControls/$(creatorId)).data.ownerUid == request.auth.uid;
  }
  function creatorModeActive(creatorId) {
    return creatorOwner(creatorId)
      && get(/databases/$(database)/documents/creatorAccounts/$(request.auth.uid)).data.creatorId == creatorId
      && get(/databases/$(database)/documents/creatorAccounts/$(request.auth.uid)).data.status == 'active';
  }
  function validCreatorProfile(data, creatorId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'creatorId', 'displayName', 'bio', 'specialties', 'socialLinks', 'status', 'platformStatus', 'createdAt', 'updatedAt'])
      && validV1(data, 'creator-profile-v1') && data.creatorId == creatorId
      && validCreatorText(data.displayName, 2, 40)
      && data.bio is string && data.bio.size() <= 750 && !data.bio.matches('.*[<>].*')
      && data.specialties is list && data.specialties.size() <= 6 && data.specialties.toSet().size() == data.specialties.size()
      && data.specialties.hasOnly(['strength', 'hypertrophy', 'general-fitness', 'conditioning', 'mobility', 'beginner-training'])
      && validCreatorSocialLinks(data.socialLinks)
      && data.status in ['draft', 'published', 'paused'] && data.platformStatus in ['active', 'suspended']
      && validTimestamps(data);
  }
  function validPublicationControl(data, listingId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'creatorId', 'listingId', 'sourceProgramId', 'sourceVersionId', 'currentPublicationVersion', 'currentPublicVersionId', 'createdAt', 'updatedAt'])
      && validV1(data, 'creator-program-publication-v1')
      && data.listingId == listingId && validCreatorId(data.creatorId) && data.ownerUid is string
