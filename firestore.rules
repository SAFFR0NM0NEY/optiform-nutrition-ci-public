      && validPendingChallenge(request.resource.data, challengeId)
      && isAcceptedFriend(request.resource.data.creatorUid, request.resource.data.inviteeUid)
      && !isBlocked(request.resource.data.creatorUid, request.resource.data.inviteeUid)
      && get(/databases/$(database)/documents/friendProfiles/$(request.resource.data.creatorUid)).data.displayName == request.resource.data.creatorDisplayName
      && get(/databases/$(database)/documents/friendProfiles/$(request.resource.data.inviteeUid)).data.displayName == request.resource.data.inviteeDisplayName;
    allow update: if signedIn() && request.auth.uid in resource.data.participantUids
