    allow update: if owner(uid) && validCoachProfile(request.resource.data, uid)
      && sameOwnerUid()
      && sameCreatedAt()
      && request.resource.data.updatedAt == request.time
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'currentCode', 'updatedAt'])
      && ((request.resource.data.status == 'paused'
          && !existsAfter(/databases/$(database)/documents/coachCodes/$(request.resource.data.currentCode)))
        || (request.resource.data.status == 'active'
          && getAfter(/databases/$(database)/documents/coachCodes/$(request.resource.data.currentCode)).data.coachUid == uid));
  }
  match /coachCodes/{code} {
    allow get: if signedIn() && resource.data.status == 'active'
      && !isBlocked(request.auth.uid, resource.data.coachUid);
    allow list: if false;
    allow create: if signedIn() && request.resource.data.coachUid == request.auth.uid
      && validCoachCode(request.resource.data, code)
      && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
      && getAfter(coachProfilePath(request.auth.uid)).data.status == 'active'
      && getAfter(coachProfilePath(request.auth.uid)).data.currentCode == code;
    allow update: if false;
    allow delete: if signedIn() && resource.data.coachUid == request.auth.uid
      && (!existsAfter(coachProfilePath(request.auth.uid))
        || getAfter(coachProfilePath(request.auth.uid)).data.status == 'paused'
        || getAfter(coachProfilePath(request.auth.uid)).data.currentCode != code);
  }
  match /coachRelationships/{id} {
    allow get, list: if signedIn() && request.auth.uid in resource.data.participantUids;
    allow create: if signedIn() && request.resource.data.athleteUid == request.auth.uid
      && validCoachRelationship(request.resource.data, id) && request.resource.data.status == 'pending'
      && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
      && request.resource.data.cycle == 1
      && !isBlocked(request.resource.data.coachUid, request.resource.data.athleteUid)
      && get(coachProfilePath(request.resource.data.coachUid)).data.status == 'active'
      && get(coachProfilePath(request.resource.data.coachUid)).data.displayName == request.resource.data.coachDisplayName
      && get(coachProfilePath(request.resource.data.coachUid)).data.currentCode == request.resource.data.coachCodeUsed
      && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.coachCodeUsed)).data.coachUid == request.resource.data.coachUid;
    allow update: if signedIn() && validCoachRelationship(request.resource.data, id)
      && request.resource.data.coachUid == resource.data.coachUid
      && request.resource.data.athleteUid == resource.data.athleteUid
      && request.resource.data.participantUids == resource.data.participantUids
      && request.resource.data.relationshipId == resource.data.relationshipId
      && sameContract()
      && sameCreatedAt()
      && request.resource.data.updatedAt == request.time
      && (
        (resource.data.status == 'pending' && request.resource.data.cycle == resource.data.cycle
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'capabilities', 'updatedAt', 'respondedAt', 'endedAt'])
          && ((request.auth.uid == resource.data.coachUid && request.resource.data.status in ['active', 'declined']
                && get(coachProfilePath(resource.data.coachUid)).data.status == 'active')
            || (request.auth.uid == resource.data.athleteUid && request.resource.data.status == 'cancelled')))
        || (resource.data.status == 'active' && request.resource.data.cycle == resource.data.cycle
          && ((request.auth.uid == resource.data.athleteUid && request.resource.data.status == 'active'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capabilities', 'updatedAt', 'respondedAt']))
            || (request.auth.uid == resource.data.athleteUid && request.resource.data.status == 'revoked')
            || (request.auth.uid == resource.data.coachUid && request.resource.data.status == 'ended'
              && get(coachProfilePath(resource.data.coachUid)).data.status == 'active'))
          && (request.resource.data.status == 'active'
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'capabilities', 'updatedAt', 'endedAt'])))
        || (terminalCoachStatus(resource.data.status) && request.auth.uid == resource.data.athleteUid
          && request.resource.data.status == 'pending' && request.resource.data.cycle == resource.data.cycle + 1
          && exists(/databases/$(database)/documents/coachRelationships/$(id)/history/$(resource.data.cycle))
          && !isBlocked(resource.data.coachUid, resource.data.athleteUid)
          && get(coachProfilePath(resource.data.coachUid)).data.status == 'active'
          && get(coachProfilePath(resource.data.coachUid)).data.currentCode == request.resource.data.coachCodeUsed
          && get(/databases/$(database)/documents/coachCodes/$(request.resource.data.coachCodeUsed)).data.coachUid == resource.data.coachUid)
      )
      && (resource.data.status != 'pending' || request.resource.data.status != 'active'
        || request.resource.data.respondedAt == request.time)
      && (!terminalCoachStatus(request.resource.data.status)
        || getAfter(/databases/$(database)/documents/coachRelationships/$(id)/history/$(request.resource.data.cycle)).data.terminalStatus == request.resource.data.status);
    allow delete: if false;
    match /history/{historyId} {
      allow get, list: if signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/coachRelationships/$(id)).data.participantUids;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participantUids
        && validCoachHistory(request.resource.data,
          getAfter(/databases/$(database)/documents/coachRelationships/$(id)).data, id, historyId);
      allow update, delete: if false;
    }
  }
  match /friendCodes/{code} {
    allow get: if signedIn() && !isBlocked(request.auth.uid, resource.data.ownerUid);
    allow list: if false;
    allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
      && validFriendCode(request.resource.data, code)
      && getAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.currentFriendCode == code
      && getAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.displayName == request.resource.data.displayName;
    allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
      && validFriendCode(request.resource.data, code)
      && sameOwnerUid()
      && request.resource.data.code == resource.data.code
      && sameCreatedAt()
      && request.resource.data.displayName == getAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.displayName
      && advancesUpdatedAt();
    allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid
      && (!getAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.keys().hasAny(['currentFriendCode'])
        || getAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.currentFriendCode != code);
  }
  match /friendships/{id} {
    allow get: if signedIn() && request.auth.uid in resource.data.participantUids;
    allow list: if signedIn() && request.auth.uid in resource.data.participantUids;
    allow create: if signedIn() && validFriendship(request.resource.data, id)
      && request.resource.data.status == 'pending'
      && request.resource.data.requesterUid == request.auth.uid
      && !isBlocked(request.resource.data.requesterUid, request.resource.data.recipientUid)
      && exists(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current)
      && get(/databases/$(database)/documents/athletes/$(request.auth.uid)/socialSettings/current).data.displayName == request.resource.data.requesterDisplayName
      && exists(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCodeUsed))
      && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCodeUsed)).data.ownerUid == request.resource.data.recipientUid
      && get(/databases/$(database)/documents/friendCodes/$(request.resource.data.friendCodeUsed)).data.displayName == request.resource.data.recipientDisplayName;
    allow update: if signedIn() && validFriendship(request.resource.data, id)
      && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
      && request.auth.uid == resource.data.recipientUid
      && !isBlocked(resource.data.requesterUid, resource.data.recipientUid)
