      && data.stationId == stationId && validGymId(stationId) && validGymId(data.gymId)
      && validGymText(data.label, 1, 80) && data.exerciseId is string
      && data.status in ['active', 'paused'] && validTimestamps(data);
  }
  function publishedSystemExercise(exerciseId) {
    return exists(/databases/$(database)/documents/exercises/$(exerciseId))
      && get(/databases/$(database)/documents/exercises/$(exerciseId)).data.source == 'system'
      && get(/databases/$(database)/documents/exercises/$(exerciseId)).data.status == 'published';
  }

  match /gymBusinessControls/{gymId} {
    allow get: if gymOwner(gymId) || activeGymStaffHas(gymId, 'gym-member-invite-manage') || platformAdmin();
    allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || platformAdmin());
    allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid
      && validGymControl(request.resource.data, gymId)
      && !exists(/databases/$(database)/documents/gymBusinessControls/$(gymId))
      && getAfter(/databases/$(database)/documents/gymBusinessProfiles/$(gymId)).data.gymId == gymId
      && getAfter(gymInvitePath(request.resource.data.currentInviteCode)).data.gymId == gymId;
    allow update: if gymOwnerOrStaffHas(gymId, 'gym-member-invite-manage') && validGymControl(request.resource.data, gymId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentInviteCode', 'updatedAt'])
      && request.resource.data.currentInviteCode != resource.data.currentInviteCode
      && validGymInvite(getAfter(gymInvitePath(request.resource.data.currentInviteCode)).data, request.resource.data.currentInviteCode)
      && getAfter(gymInvitePath(request.resource.data.currentInviteCode)).data.gymId == gymId
      && getAfter(gymInvitePath(request.resource.data.currentInviteCode)).data.status == 'active'
      && validGymInvite(getAfter(gymInvitePath(resource.data.currentInviteCode)).data, resource.data.currentInviteCode)
      && getAfter(gymInvitePath(resource.data.currentInviteCode)).data.gymId == gymId
      && getAfter(gymInvitePath(resource.data.currentInviteCode)).data.status == 'revoked';
    allow delete: if false;
  }
  match /gymBusinessProfiles/{gymId} {
    allow get: if signedIn() && ((resource.data.status == 'active' && resource.data.platformStatus == 'active') || gymOwner(gymId) || activeMember(gymId) || moderator());
    allow list: if false;
    allow create: if validGymProfile(request.resource.data, gymId)
      && request.resource.data.status == 'active' && request.resource.data.platformStatus == 'active'
      && gymOwnerAfter(gymId);
    allow update: if validGymProfile(request.resource.data, gymId)
      && ((gymOwner(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'description', 'status', 'updatedAt']) && request.resource.data.platformStatus == resource.data.platformStatus)
        || (activeGymStaffHas(gymId, 'gym-profile-edit') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'description', 'updatedAt']))
        || (moderator() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['platformStatus', 'updatedAt'])));
    allow delete: if false;
  }
  match /gymInvites/{code} {
    allow get: if signedIn() && resource.data.code == code;
    allow list: if false;
    allow create: if validGymInvite(request.resource.data, code) && request.resource.data.status == 'active'
      && request.resource.data.createdAt == request.time
      && request.resource.data.expiresAt > request.time
      && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
      && (gymOwnerAfter(request.resource.data.gymId) || activeGymStaffHas(request.resource.data.gymId, 'gym-member-invite-manage'))
      && getAfter(/databases/$(database)/documents/gymBusinessControls/$(request.resource.data.gymId)).data.currentInviteCode == code;
    allow update: if gymOwnerOrStaffHas(resource.data.gymId, 'gym-member-invite-manage') && validGymInvite(request.resource.data, code)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      && resource.data.status == 'active' && request.resource.data.status == 'revoked';
    allow delete: if false;
  }
  match /gymMemberships/{gymId}/members/{uid} {
    allow get: if owner(uid) || gymOwner(gymId) || platformAdmin();
    allow list: if owner(uid) || gymOwner(gymId) || platformAdmin();
    allow create: if owner(uid) && validGymMembership(request.resource.data, gymId, uid)
      && request.resource.data.status == 'active' && request.resource.data.cycle == 1
      && request.resource.data.joinedAt == request.time && request.resource.data.updatedAt == request.time
      && usableInvite(request.resource.data.inviteCodeUsed, gymId)
      && directoryMatchesMembership(getAfter(/databases/$(database)/documents/gymMemberDirectory/$(gymId)/members/$(request.resource.data.memberId)).data, gymId, uid)
      && getAfter(/databases/$(database)/documents/gymMembershipIndexes/$(uid)/items/$(gymId)).data.status == 'active';
    allow update: if validGymMembership(request.resource.data, gymId, uid)
      && request.resource.data.gymId == resource.data.gymId && request.resource.data.memberUid == resource.data.memberUid
      && ((resource.data.status == 'active' && request.resource.data.status in ['left', 'removed']
          && ((owner(uid) && request.resource.data.status == 'left') || (gymOwner(gymId) && request.resource.data.status == 'removed'))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'endedAt'])
          && request.resource.data.updatedAt == request.time && request.resource.data.endedAt == request.time
          && historyMatchesMembership(getAfter(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)/history/$(resource.data.cycle)).data, request.resource.data)
          && directoryMatchesMembership(getAfter(/databases/$(database)/documents/gymMemberDirectory/$(gymId)/members/$(resource.data.memberId)).data, gymId, uid)
          && getAfter(/databases/$(database)/documents/gymMembershipIndexes/$(uid)/items/$(gymId)).data.status == request.resource.data.status)
        || (owner(uid) && resource.data.status in ['left', 'removed'] && request.resource.data.status == 'active'
          && request.resource.data.cycle == resource.data.cycle + 1 && request.resource.data.memberId != resource.data.memberId
          && request.resource.data.joinedAt == request.time && request.resource.data.updatedAt == request.time
          && usableInvite(request.resource.data.inviteCodeUsed, gymId)
          && historyMatchesMembership(get(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)/history/$(resource.data.cycle)).data, resource.data)
          && directoryMatchesMembership(getAfter(/databases/$(database)/documents/gymMemberDirectory/$(gymId)/members/$(request.resource.data.memberId)).data, gymId, uid)
          && getAfter(/databases/$(database)/documents/gymMembershipIndexes/$(uid)/items/$(gymId)).data.status == 'active'));
    allow delete: if false;
    match /history/{cycle} {
      allow get, list: if owner(uid) || gymOwner(gymId) || platformAdmin();
      allow create: if (owner(uid) || gymOwner(gymId)) && validGymHistory(request.resource.data, gymId, uid, cycle)
        && request.resource.data.updatedAt == request.time && request.resource.data.endedAt == request.time
        && historyMatchesMembership(request.resource.data, getAfter(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)).data)
        && !exists(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)/history/$(cycle));
      allow update, delete: if false;
    }
  }
  match /gymMembershipIndexes/{uid}/items/{gymId} {
    allow get, list: if owner(uid);
    allow create: if owner(uid) && validGymMembershipIndex(request.resource.data, uid, gymId)
      && request.resource.data.status == 'active'
      && request.resource.data.updatedAt == request.time
      && getAfter(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)).data.status == 'active';
    allow update: if (owner(uid) || gymOwner(gymId)) && validGymMembershipIndex(request.resource.data, uid, gymId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      && request.resource.data.updatedAt == request.time
      && getAfter(/databases/$(database)/documents/gymMemberships/$(gymId)/members/$(uid)).data.status == request.resource.data.status;
    allow delete: if false;
  }
  match /gymStaffInvites/{code} {
    allow get: if signedIn();
    allow list: if signedIn() && gymOwner(resource.data.gymId);
    allow create: if validGymStaffInvite(request.resource.data, code)
      && request.resource.data.status == 'active' && request.resource.data.createdAt == request.time
      && request.resource.data.expiresAt > request.time
      && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
      && gymOwner(request.resource.data.gymId) && activeGym(request.resource.data.gymId);
    allow update: if validGymStaffInvite(request.resource.data, code)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt'])
      && ((gymOwner(resource.data.gymId) && resource.data.status == 'active' && request.resource.data.status == 'revoked' && !request.resource.data.keys().hasAny(['acceptedAt']))
        || (signedIn() && resource.data.status == 'active' && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedAt == request.time && request.auth.uid != get(/databases/$(database)/documents/gymBusinessControls/$(resource.data.gymId)).data.ownerUid
          && getAfter(/databases/$(database)/documents/gymStaffMemberships/$(resource.data.gymId)/staffMembers/$(request.auth.uid)).data.inviteCodeUsed == code));
    allow delete: if false;
  }
  match /gymStaffMemberships/{gymId}/staffMembers/{uid} {
    allow get: if owner(uid) || gymOwner(gymId) || platformAdmin();
    allow list: if gymOwner(gymId) || platformAdmin();
    allow create: if owner(uid) && validGymStaffMembership(request.resource.data, gymId, uid)
      && request.resource.data.status == 'active' && request.resource.data.cycle == 1 && request.resource.data.revision == 1
      && request.resource.data.joinedAt == request.time && request.resource.data.updatedAt == request.time
      && request.auth.uid != get(/databases/$(database)/documents/gymBusinessControls/$(gymId)).data.ownerUid
      && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.status == 'active'
      && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.gymId == gymId
      && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.expiresAt > request.time
      && request.resource.data.role == get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.role
      && request.resource.data.capabilities == get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.capabilities
      && getAfter(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.status == 'accepted'
      && gymStaffHistoryMatches(getAfter(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)/history/1).data, request.resource.data)
      && getAfter(/databases/$(database)/documents/gymStaffIndexes/$(uid)/items/$(gymId)).data.status == 'active';
    allow update: if validGymStaffMembership(request.resource.data, gymId, uid)
      && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time
      && gymStaffHistoryMatches(getAfter(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)/history/$(request.resource.data.revision)).data, request.resource.data)
      && ((gymOwner(gymId) && resource.data.status == 'active' && request.resource.data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'capabilities', 'revision', 'updatedAt']))
        || (resource.data.status == 'active' && request.resource.data.status in ['left', 'revoked']
          && ((owner(uid) && request.resource.data.status == 'left') || (gymOwner(gymId) && request.resource.data.status == 'revoked'))
          && request.resource.data.endedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'revision', 'updatedAt', 'endedAt'])
          && getAfter(/databases/$(database)/documents/gymStaffIndexes/$(uid)/items/$(gymId)).data.status == request.resource.data.status)
        || (owner(uid) && resource.data.status in ['left', 'revoked'] && request.resource.data.status == 'active'
          && request.resource.data.cycle == resource.data.cycle + 1 && request.resource.data.staffId != resource.data.staffId
          && request.resource.data.joinedAt == request.time
          && gymStaffHistoryMatches(get(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)/history/$(resource.data.revision)).data, resource.data)
          && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.status == 'active'
          && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.gymId == gymId
          && get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.expiresAt > request.time
          && getAfter(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.status == 'accepted'
          && request.resource.data.role == get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.role
          && request.resource.data.capabilities == get(gymStaffInvitePath(request.resource.data.inviteCodeUsed)).data.capabilities
          && getAfter(/databases/$(database)/documents/gymStaffIndexes/$(uid)/items/$(gymId)).data.status == 'active'));
    allow delete: if false;
    match /history/{revision} {
      allow get, list: if owner(uid) || gymOwner(gymId) || platformAdmin();
      allow create: if (owner(uid) || gymOwner(gymId)) && int(revision) == request.resource.data.revision
        && request.resource.data.updatedAt == request.time
        && gymStaffHistoryMatches(request.resource.data, getAfter(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)).data)
        && !exists(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)/history/$(revision));
      allow update, delete: if false;
    }
  }
  match /gymStaffIndexes/{uid}/items/{gymId} {
    allow get, list: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'gymId', 'status', 'updatedAt'])
      && validV1(request.resource.data, 'gym-staff-membership-v1')
      && request.resource.data.ownerUid == uid && request.resource.data.gymId == gymId && request.resource.data.status == 'active'
      && request.resource.data.updatedAt == request.time && getAfter(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)).data.status == 'active';
    allow update: if (owner(uid) || gymOwner(gymId))
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
      && request.resource.data.status in ['active', 'left', 'revoked'] && request.resource.data.updatedAt == request.time
      && getAfter(/databases/$(database)/documents/gymStaffMemberships/$(gymId)/staffMembers/$(uid)).data.status == request.resource.data.status;
    allow delete: if false;
  }
  match /gymMemberDirectory/{gymId}/members/{memberId} {
    allow get, list: if signedIn() && ((resource.data.status == 'active' && (activeMember(gymId) || activeGymStaffHas(gymId, 'gym-member-directory-read'))) || gymOwner(gymId) || platformAdmin());
    allow create: if signedIn() && validGymDirectory(request.resource.data, gymId, memberId)
      && request.resource.data.status == 'active'
      && getAfter(/databases/$(database)/documents/gymMemberDirectoryControls/$(gymId)/entries/$(memberId)).data.memberUid == request.auth.uid
      && directoryMatchesMembership(request.resource.data, gymId, request.auth.uid);
    allow update: if signedIn() && validGymDirectory(request.resource.data, gymId, memberId)
      && resource.data.status == 'active' && request.resource.data.status in ['left', 'removed']
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'endedAt'])
      && (request.auth.uid == get(/databases/$(database)/documents/gymMemberDirectoryControls/$(gymId)/entries/$(memberId)).data.memberUid || gymOwner(gymId))
      && directoryMatchesMembership(request.resource.data, gymId, get(/databases/$(database)/documents/gymMemberDirectoryControls/$(gymId)/entries/$(memberId)).data.memberUid);
    allow delete: if false;
  }
  match /gymMemberDirectoryControls/{gymId}/entries/{memberId} {
    allow get: if signedIn() && (request.auth.uid == resource.data.memberUid || gymOwner(gymId) || platformAdmin());
    allow list: if gymOwner(gymId) || platformAdmin();
    allow create: if signedIn() && validGymDirectoryControl(request.resource.data, gymId, memberId)
      && request.resource.data.memberUid == request.auth.uid
      && directoryMatchesMembership(getAfter(/databases/$(database)/documents/gymMemberDirectory/$(gymId)/members/$(memberId)).data, gymId, request.auth.uid);
    allow update, delete: if false;
  }
  match /gymAnnouncements/{gymId}/items/{announcementId} {
    allow get, list: if signedIn() && ((resource.data.status == 'active' && (activeMember(gymId) || activeGymStaffHas(gymId, 'gym-announcements-manage'))) || gymOwner(gymId) || moderator());
    allow create: if gymOwnerOrStaffHas(gymId, 'gym-announcements-manage') && validGymAnnouncement(request.resource.data, gymId, announcementId) && request.resource.data.status == 'active';
    allow update: if gymOwnerOrStaffHas(gymId, 'gym-announcements-manage') && validGymAnnouncement(request.resource.data, gymId, announcementId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body', 'status', 'updatedAt']);
    allow delete: if false;
  }
  match /gymStations/{stationId} {
    allow get: if signedIn() && ((resource.data.status == 'active' && activeGym(resource.data.gymId)) || gymOwner(resource.data.gymId) || moderator());
    allow list: if signedIn() && (gymOwner(resource.data.gymId) || activeMember(resource.data.gymId) || activeGymStaffHas(resource.data.gymId, 'gym-stations-manage'));
    allow create: if validGymStation(request.resource.data, stationId) && gymOwnerOrStaffHas(request.resource.data.gymId, 'gym-stations-manage')
      && publishedSystemExercise(request.resource.data.exerciseId);
    allow update: if validGymStation(request.resource.data, stationId) && gymOwnerOrStaffHas(resource.data.gymId, 'gym-stations-manage')
      && request.resource.data.gymId == resource.data.gymId && sameCreatedAt()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['label', 'exerciseId', 'status', 'updatedAt'])
      && publishedSystemExercise(request.resource.data.exerciseId);
    allow delete: if false;
  }
  match /gymChallenges/{challengeId} {
    allow get, list: if activeMember(resource.data.gymId) || gymOwner(resource.data.gymId) || platformAdmin();
    allow create: if validGymChallenge(request.resource.data, challengeId)
      && gymOwner(request.resource.data.gymId) && activeGym(request.resource.data.gymId)
      && request.resource.data.status == 'enabled' && request.resource.data.participantCount == 0
      && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
      && request.resource.data.startsAt >= request.time + duration.value(15, 'm')
      && request.resource.data.startsAt <= request.time + duration.value(7, 'd');
    allow update: if validGymChallenge(request.resource.data, challengeId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'participantCount', 'updatedAt', 'cancelledAt', 'archivedAt'])
      && request.resource.data.updatedAt == request.time
      && ((activeMember(resource.data.gymId) && resource.data.status == 'enabled'
          && request.time < resource.data.startsAt && resource.data.participantCount < 50
          && request.resource.data.status == 'enabled'
          && request.resource.data.participantCount == resource.data.participantCount + 1
          && newGymChallengeParticipation(challengeId, resource.data.gymId))
        || (gymOwner(resource.data.gymId) && resource.data.status == 'enabled'
          && request.time < resource.data.startsAt && request.resource.data.status == 'cancelled'
          && request.resource.data.participantCount == resource.data.participantCount
          && request.resource.data.cancelledAt == request.time)
        || (gymOwner(resource.data.gymId) && resource.data.status in ['enabled', 'cancelled']
          && request.time >= resource.data.finalizeAfter && request.resource.data.status == 'archived'
          && request.resource.data.participantCount == resource.data.participantCount
          && request.resource.data.archivedAt == request.time));
    allow delete: if false;
    match /participants/{participantId} {
      allow get, list: if gymChallengeViewer(challengeId);
      allow create: if signedIn()
        && gymChallengeParticipantMatches(request.resource.data, getAfter(/databases/$(database)/documents/gymChallengeParticipantControls/$(challengeId)/participants/$(request.auth.uid)).data)
        && request.resource.data.participantId == participantId
        && request.resource.data.displayName == get(/databases/$(database)/documents/gymMemberships/$(request.resource.data.gymId)/members/$(request.auth.uid)).data.displayNameSnapshot;
      allow update, delete: if false;
    }
    match /evidence/{evidenceId} {
      allow get, list: if gymChallengeViewer(challengeId);
      allow create: if signedIn()
        && gymChallengeEvidenceProjectionMatches(request.resource.data, getAfter(/databases/$(database)/documents/gymChallengeEvidenceControls/$(challengeId)/entries/$(evidenceId)).data);
      allow update, delete: if false;
    }
  }
  match /gymChallengeParticipantControls/{challengeId}/participants/{uid} {
    allow get: if owner(uid); allow list: if false;
    allow create: if owner(uid) && validGymChallengeControl(request.resource.data, challengeId, uid)
      && activeMember(request.resource.data.gymId)
      && request.resource.data.membershipCycle == get(/databases/$(database)/documents/gymMemberships/$(request.resource.data.gymId)/members/$(uid)).data.cycle
      && getAfter(/databases/$(database)/documents/gymChallenges/$(challengeId)).data.participantCount
        == get(/databases/$(database)/documents/gymChallenges/$(challengeId)).data.participantCount + 1
      && get(/databases/$(database)/documents/gymChallenges/$(challengeId)).data.gymId == request.resource.data.gymId
      && get(/databases/$(database)/documents/gymChallenges/$(challengeId)).data.status == 'enabled'
      && request.time < get(/databases/$(database)/documents/gymChallenges/$(challengeId)).data.startsAt
      && gymChallengeParticipantMatches(getAfter(/databases/$(database)/documents/gymChallenges/$(challengeId)/participants/$(request.resource.data.participantId)).data, request.resource.data);
    allow update, delete: if false;
  }
  match /gymChallengeEvidenceControls/{challengeId}/entries/{evidenceId} {
    allow get: if signedIn() && resource.data.participantUid == request.auth.uid;
    allow list: if false;
    allow create: if signedIn() && validGymChallengeEvidence(request.resource.data, challengeId, evidenceId)
      && gymChallengeEvidenceProjectionMatches(getAfter(/databases/$(database)/documents/gymChallenges/$(challengeId)/evidence/$(evidenceId)).data, request.resource.data);
    allow update, delete: if false;
  }

  match /athletes/{uid}/{document=**} { allow read, write: if false; }

  // Every other collection remains deny-by-default until its authenticated data model exists.
  match /{document=**} {
    allow read, write: if false;
  }
}
}
