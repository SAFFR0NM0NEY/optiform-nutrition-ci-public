        && data.provenance.kind == 'imported' && data.provenance.provider in ['health-connect', 'fitbit', 'garmin', 'samsung-health', 'apple-health']
        && data.provenance.externalRecordKeyHash is string && data.provenance.externalRecordKeyHash.matches('^[a-f0-9]{64}$') && data.provenance.importedAt is timestamp);
  }
  function validWellnessObservation(data, uid, observationId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'observationId', 'metric', 'dateLocal', 'value', 'source', 'provenance', 'createdAt', 'updatedAt'])
      && validV1(data, 'wellness-observation-v1') && data.ownerUid == uid && data.observationId == observationId
      && data.metric in ['steps', 'resting-heart-rate', 'sleep-duration', 'workout-duration', 'cardio-duration'] && validWellnessDate(data.dateLocal)
      && data.value is number && data.value >= 0 && data.value <= 10000000
      && (!(data.metric in ['steps', 'resting-heart-rate']) || data.value is int)
      && validObservationProvenance(data) && validTimestamps(data);
  }
  function currentCommunityConsent(uid) {
    return exists(/databases/$(database)/documents/athletes/$(uid)/policyConsents/community-guidelines--2026.09-beta.1);
  }
  function validPolicyConsent(data, uid, consentId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'policyId', 'policyVersion', 'policyStatusAtAcceptance', 'acceptedAt', 'acceptanceSource'])
      && validV1(data, 'policy-consent-v1')
      && data.ownerUid == uid
      && data.policyId in ['terms-of-use', 'privacy-notice', 'community-guidelines', 'fitness-safety-notice']
      && data.policyVersion == '2026.09-beta.1'
      && consentId == data.policyId + '--' + data.policyVersion
      && data.policyStatusAtAcceptance == 'beta-draft'
      && data.acceptanceSource == 'in-app'
      && data.acceptedAt is timestamp && data.acceptedAt <= request.time
      && data.acceptedAt > request.time - duration.value(5, 'm');
  }
  function validDeletionRequest(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'status', 'requestedAt'])
      && validV1(data, 'account-deletion-request-v1')
      && data.ownerUid == uid && data.status == 'requested'
      && data.requestedAt is timestamp && data.requestedAt <= request.time
      && data.requestedAt > request.time - duration.value(5, 'm');
  }
  function validModerationCase(data, reportId) {
    let report = get(/databases/$(database)/documents/socialReports/$(reportId)).data;
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'reportId', 'targetType', 'targetOwnerUid', 'targetId', 'status', 'assignedOperatorUid', 'resolutionCode', 'createdAt', 'updatedAt'])
      && validV1(data, 'moderation-operations-v1')
      && data.reportId == reportId && exists(/databases/$(database)/documents/socialReports/$(reportId))
      && data.targetType == report.targetType
      && data.targetOwnerUid == report.targetOwnerUid
      && data.targetId == report.targetId
      && data.status in ['open', 'reviewing', 'resolved', 'dismissed']
      && (!data.keys().hasAny(['assignedOperatorUid']) || data.assignedOperatorUid is string)
      && (!data.keys().hasAny(['resolutionCode']) || data.resolutionCode in ['spam', 'harassment', 'inappropriate', 'privacy', 'other', 'legacy-target-unresolvable'])
      && validTimestamps(data);
  }
  function validModerationTargetAuthorization(data, targetKey) {
    let report = get(/databases/$(database)/documents/socialReports/$(data.reportId)).data;
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'targetKey', 'reportId', 'targetType', 'targetOwnerUid', 'targetId', 'createdByUid', 'action', 'auditEventId', 'createdAt'])
      && validV1(data, 'moderation-operations-v1')
      && data.targetKey == targetKey && data.createdByUid == request.auth.uid
      && exists(/databases/$(database)/documents/socialReports/$(data.reportId))
      && data.targetType == report.targetType
      && data.targetOwnerUid == report.targetOwnerUid
      && data.targetId == report.targetId
      && ((!data.keys().hasAny(['action', 'auditEventId']))
        || (data.keys().hasAll(['action', 'auditEventId'])
          && data.action == 'remove-' + data.targetType
          && existsAfter(/databases/$(database)/documents/platformAudit/$(data.auditEventId))))
      && data.createdAt == request.time;
  }
  function validSupportTicket(data, ticketId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ticketId', 'ownerUid', 'category', 'subject', 'status', 'createdAt', 'updatedAt'])
      && validV1(data, 'support-cases-v1')
      && data.ticketId == ticketId && data.ownerUid is string
      && data.category in ['account', 'privacy', 'technical', 'safety', 'other']
      && data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 100
      && !data.subject.matches('.*[<>].*')
      && data.status in ['open', 'waiting-on-user', 'waiting-on-support', 'resolved', 'closed']
      && validTimestamps(data);
  }
  function validSupportMessage(data, ticketId, messageId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'messageId', 'ticketId', 'senderUid', 'senderType', 'body', 'createdAt'])
      && validV1(data, 'support-cases-v1')
      && data.ticketId == ticketId && data.messageId == messageId
      && data.senderUid == request.auth.uid && data.senderType in ['athlete', 'operator']
      && data.body is string && data.body.size() >= 1 && data.body.size() <= 2000
      && !data.body.matches('.*[<>].*')
      && data.createdAt == request.time;
  }
  function validDeletionOperation(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'status', 'assignedOperatorUid', 'reasonCode', 'createdAt', 'updatedAt'])
      && validV1(data, 'account-deletion-operations-v1')
      && data.ownerUid == uid && data.status in ['queued', 'processing', 'blocked', 'rejected']
      && (!data.keys().hasAny(['assignedOperatorUid']) || data.assignedOperatorUid == request.auth.uid)
      && (!data.keys().hasAny(['reasonCode']) || data.reasonCode in ['retention-review', 'identity-check', 'legal-hold', 'request-invalid', 'other'])
      && data.createdAt is timestamp && data.updatedAt == request.time;
  }
  function validVerificationCase(data, caseId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'caseId', 'subjectUid', 'sourceType', 'sourceId', 'outcome', 'assignedOperatorUid', 'createdAt', 'updatedAt'])
      && validV1(data, 'verification-review-v1')
      && data.caseId == caseId && data.subjectUid is string && data.sourceType is string && data.sourceType.size() <= 50
      && data.sourceId is string && data.sourceId.size() <= 200
      && data.outcome in ['pending', 'in-review', 'source-consistent', 'insufficient', 'rejected']
      && (!data.keys().hasAny(['assignedOperatorUid']) || data.assignedOperatorUid == request.auth.uid)
      && data.createdAt is timestamp && data.updatedAt == request.time;
  }
  function validPlatformAudit(data, eventId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'eventId', 'actorUid', 'actorRoles', 'action', 'caseId', 'targetType', 'targetOwnerUid', 'targetId', 'reasonCode', 'createdAt'])
      && validV1(data, 'platform-enforcement-v1')
      && data.eventId == eventId && data.actorUid == request.auth.uid
      && data.actorRoles is list && data.actorRoles.size() > 0
      && data.actorRoles.hasOnly(['platform-admin', 'moderator', 'support', 'verifier'])
      && request.auth.token.keys().hasAny(['optiformRoles'])
      && request.auth.token.optiformRoles is list
      && data.actorRoles.hasOnly(request.auth.token.optiformRoles)
      && data.action in ['dismiss-report', 'remove-profile', 'remove-post', 'remove-comment', 'restrict-social-publishing', 'clear-social-restriction', 'support-status', 'support-reply', 'deletion-status', 'verification-outcome', 'publish-competition-result', 'competition-review-outcome', 'invalidate-competition-result', 'reconcile-competition-meta-season', 'finalize-competition-meta-season', 'correct-competition-meta-season']
      && data.targetType in ['profile', 'post', 'comment', 'support-ticket', 'account-deletion', 'verification-case', 'competition-result', 'competition-meta-season']
      && data.reasonCode is string && data.reasonCode.size() <= 60
      && data.createdAt == request.time;
  }
  function currentAccountPolicies(uid) {
    return exists(/databases/$(database)/documents/athletes/$(uid)/policyConsents/terms-of-use--2026.09-beta.1)
      && exists(/databases/$(database)/documents/athletes/$(uid)/policyConsents/privacy-notice--2026.09-beta.1);
  }
  function activeCompetitionOptIn(uid) {
    return exists(/databases/$(database)/documents/publicCompetitionOptIns/$(uid))
      && get(/databases/$(database)/documents/publicCompetitionOptIns/$(uid)).data.status == 'active';
  }
  function competitionSubmissionPath(submissionId) {
    return /databases/$(database)/documents/competitionSubmissions/$(submissionId);
  }
  function validCompetitionEvent(data, eventId) {
    let exercise = get(/databases/$(database)/documents/exercises/$(data.exerciseId)).data;
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'eventId', 'exerciseId', 'exerciseName', 'targetReps', 'scoreMetric', 'competitionClass', 'status', 'startsAt', 'endsAt', 'reviewEndsAt', 'createdByUid', 'createdAt', 'updatedAt'])
      && validV1(data, 'competition-events-v1')
      && data.eventId == eventId && data.exerciseId is string && data.exerciseName is string
      && data.targetReps is int && data.targetReps >= 1 && data.targetReps <= 100
      && data.scoreMetric == 'load-kg' && data.competitionClass == 'open'
      && data.status in ['draft', 'open', 'review', 'closed', 'archived']
      && data.startsAt is timestamp && data.endsAt is timestamp && data.reviewEndsAt is timestamp
      && data.startsAt < data.endsAt && data.endsAt <= data.reviewEndsAt
      && data.createdByUid is string && validTimestamps(data)
      && exists(/databases/$(database)/documents/exercises/$(data.exerciseId))
      && exercise.source == 'system'
      && exercise.status == 'published'
      && exercise.trackingProfile.supportedMetrics.hasAll(['load', 'reps']);
  }
  function validCompetitionSubmission(data, submissionId) {
    let event = get(/databases/$(database)/documents/competitionEvents/$(data.eventId)).data;
    let workout = get(/databases/$(database)/documents/athletes/$(request.auth.uid)/workouts/$(data.sourceWorkoutId)).data;
    let entry = workout.exercises[data.sourceExerciseEntryIndex];
    let workoutSet = entry.sets[data.sourceSetIndex];
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'submissionId', 'ownerUid', 'eventId', 'sourceWorkoutId', 'sourceExerciseEntryId', 'sourceExerciseEntryIndex', 'sourceSetId', 'sourceSetIndex', 'sourceClaimId', 'exerciseId', 'exerciseName', 'targetReps', 'loadKg', 'evidencePath', 'displayNameSnapshot', 'status', 'createdAt', 'updatedAt'])
      && validV1(data, 'competition-evidence-v1')
      && data.submissionId == submissionId && data.ownerUid == request.auth.uid
      && activeCompetitionOptIn(request.auth.uid) && event.status == 'open'
      && data.exerciseId == event.exerciseId && data.exerciseName == event.exerciseName && data.targetReps == event.targetReps
      && data.sourceExerciseEntryIndex is int && data.sourceSetIndex is int
      && data.sourceExerciseEntryIndex >= 0 && data.sourceExerciseEntryIndex < workout.exercises.size()
      && data.sourceSetIndex >= 0 && data.sourceSetIndex < entry.sets.size()
      && workout.ownerUid == request.auth.uid && entry.id == data.sourceExerciseEntryId
      && (!entry.exercise.keys().hasAny(['source']) || entry.exercise.source == 'system')
      && entry.exercise.exerciseId == event.exerciseId
      && workoutSet.id == data.sourceSetId && workoutSet.status == 'completed' && workoutSet.role == 'working'
      && workoutSet.values.reps == event.targetReps && workoutSet.values.load == data.loadKg
      && data.loadKg is number && data.loadKg >= 0
      && data.sourceClaimId == data.sourceWorkoutId + '--' + data.sourceExerciseEntryId + '--' + data.sourceSetId
      && data.evidencePath == 'athletes/' + request.auth.uid + '/competition-evidence/' + submissionId + '.mp4'
      && validSocialName(data.displayNameSnapshot) && data.status == 'submitted'
      && data.createdAt == request.time && data.updatedAt == request.time;
  }
  function validStanding(data) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'eventId', 'displayName', 'initials', 'exerciseName', 'targetReps', 'loadKg', 'verification', 'status', 'auditEventId', 'verifiedAt'])
      && validV1(data, 'verified-public-standings-v1')
      && validSocialName(data.displayName) && data.initials is string && data.initials.size() >= 1 && data.initials.size() <= 2
      && data.exerciseName is string && data.targetReps is int && data.loadKg is number
      && data.verification == 'evidence-verified' && data.status == 'active'
      && data.auditEventId is string && data.verifiedAt == request.time;
  }
  function linkedCompetitionAudit(auditId, action, targetId) {
    return existsAfter(/databases/$(database)/documents/platformAudit/$(auditId))
      && getAfter(/databases/$(database)/documents/platformAudit/$(auditId)).data.action == action
      && getAfter(/databases/$(database)/documents/platformAudit/$(auditId)).data.targetType == 'competition-result'
      && getAfter(/databases/$(database)/documents/platformAudit/$(auditId)).data.targetId == targetId;
  }
  match /athletes/{uid} {
    allow get: if owner(uid);
    allow list: if false;
    allow create: if owner(uid) && validAthlete(request.resource.data, uid);
    allow update: if owner(uid) && validAthlete(request.resource.data, uid)
      && sameOwnerUid()
      && sameCreatedAt()
      && advancesUpdatedAt();
    allow delete: if false;
  }

  match /athletes/{uid}/workouts/{workoutId} {
    allow get, list: if owner(uid);
    allow create: if owner(uid) && validCompletedWorkout(request.resource.data, uid, workoutId)
      && completedWorkoutCreateAuthorized(request.resource.data, uid, workoutId);
    allow update: if owner(uid)
      && validCompletedWorkout(request.resource.data, uid, workoutId)
      && request.resource.data == resource.data;
    allow delete: if false;
  }
  match /athletes/{uid}/importedWorkouts/{importedWorkoutId} {
    allow get, list: if owner(uid);
    allow create, update, delete: if false;
  }
  match /athletes/{uid}/workoutImportBatches/{batchId} {
    allow get, list: if owner(uid);
    allow create, update, delete: if false;
  }
  match /publicCompetitionOptIns/{uid} {
    allow get: if owner(uid);
    allow list: if false;
    allow create: if owner(uid) && currentAccountPolicies(uid) && currentCommunityConsent(uid)
      && request.resource.data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'acknowledgementVersion', 'status', 'acceptedAt', 'updatedAt'])
      && validV1(request.resource.data, 'public-competition-opt-in-v1')
      && request.resource.data.ownerUid == uid && request.resource.data.acknowledgementVersion == 'public-competition-v1'
      && request.resource.data.status == 'active' && request.resource.data.acceptedAt == request.time && request.resource.data.updatedAt == request.time;
    allow update: if owner(uid) && resource.data.ownerUid == uid
      && sameOwnerUid()
      && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'withdrawn' && request.resource.data.updatedAt == request.time)
        || (currentAccountPolicies(uid) && currentCommunityConsent(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acknowledgementVersion', 'acceptedAt', 'updatedAt'])
          && request.resource.data.status == 'active'
          && request.resource.data.acknowledgementVersion == 'public-competition-v1'
          && request.resource.data.acceptedAt == request.time && request.resource.data.updatedAt == request.time));
    allow delete: if false;
  }
  match /competitionEvents/{eventId} {
    allow get, list: if signedIn();
    allow create: if platformAdmin() && validCompetitionEvent(request.resource.data, eventId)
      && request.resource.data.createdByUid == request.auth.uid
      && request.resource.data.status == 'draft' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    allow update: if platformAdmin() && validCompetitionEvent(request.resource.data, eventId)
      && sameCreatedAt()
      && request.resource.data.createdByUid == resource.data.createdByUid
      && request.resource.data.eventId == resource.data.eventId
      && (resource.data.status == 'draft' || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
      && ((resource.data.status == 'draft' && request.resource.data.status in ['draft', 'open'])
        || (resource.data.status == 'open' && request.resource.data.status == 'review')
        || (resource.data.status == 'review' && request.resource.data.status == 'closed')
        || (resource.data.status == 'closed' && request.resource.data.status == 'archived'));
    allow delete: if false;
  }
  match /competitionSubmissions/{submissionId} {
    allow get: if signedIn() && (resource.data.ownerUid == request.auth.uid || verifier());
    allow list: if signedIn() && (resource.data.ownerUid == request.auth.uid || verifier());
    allow create: if signedIn() && validCompetitionSubmission(request.resource.data, submissionId)
      && existsAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/publicCompetitionEntries/$(request.resource.data.eventId))
      && existsAfter(/databases/$(database)/documents/athletes/$(request.auth.uid)/competitionSourceClaims/$(request.resource.data.sourceClaimId))
      && existsAfter(/databases/$(database)/documents/competitionEvidenceReviews/$(submissionId));
    allow update: if signedIn() && ((resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status == 'withdrawn')
      || (verifier() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedByUid', 'reviewReason', 'auditEventId', 'updatedAt'])
        && request.resource.data.status in ['evidence-verified', 'insufficient', 'rejected', 'invalidated']
        && request.resource.data.reviewedByUid == request.auth.uid
        && linkedCompetitionAudit(request.resource.data.auditEventId,
          request.resource.data.status == 'evidence-verified' ? 'publish-competition-result'
            : request.resource.data.status == 'invalidated' ? 'invalidate-competition-result' : 'competition-review-outcome',
          submissionId)));
    allow delete: if false;
  }
  match /athletes/{uid}/publicCompetitionEntries/{eventId} {
    allow get, list: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'eventId', 'submissionId', 'status', 'createdAt'])
      && request.resource.data.ownerUid == uid && request.resource.data.eventId == eventId && request.resource.data.status == 'live'
      && request.resource.data.createdAt == request.time;
    allow update: if false;
    allow delete: if owner(uid);
  }
  match /athletes/{uid}/competitionSourceClaims/{claimId} {
    allow get, list: if owner(uid);
    allow create: if owner(uid) && request.resource.data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'eventId', 'submissionId', 'sourceWorkoutId', 'sourceExerciseEntryId', 'sourceSetId', 'createdAt'])
      && request.resource.data.ownerUid == uid && claimId == request.resource.data.sourceWorkoutId + '--' + request.resource.data.sourceExerciseEntryId + '--' + request.resource.data.sourceSetId
      && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
  }
  match /competitionEvidenceReviews/{submissionId} {
    allow get: if verifier();
    allow list: if verifier();
    allow create: if signedIn() && request.resource.data.keys().hasOnly(['schemaVersion', 'contractVersion', 'submissionId', 'ownerUid', 'eventId', 'evidencePath', 'exerciseName', 'targetReps', 'loadKg', 'status', 'createdAt', 'updatedAt'])
      && request.resource.data.ownerUid == request.auth.uid && request.resource.data.submissionId == submissionId
      && getAfter(competitionSubmissionPath(submissionId)).data.ownerUid == request.auth.uid
      && request.resource.data.eventId == getAfter(competitionSubmissionPath(submissionId)).data.eventId
      && request.resource.data.evidencePath == getAfter(competitionSubmissionPath(submissionId)).data.evidencePath
      && request.resource.data.exerciseName == getAfter(competitionSubmissionPath(submissionId)).data.exerciseName
      && request.resource.data.targetReps == getAfter(competitionSubmissionPath(submissionId)).data.targetReps
      && request.resource.data.loadKg == getAfter(competitionSubmissionPath(submissionId)).data.loadKg
      && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
    allow update: if verifier() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'assignedVerifierUid', 'reason', 'auditEventId', 'updatedAt'])
      && request.resource.data.assignedVerifierUid == request.auth.uid
      && request.resource.data.status in ['evidence-verified', 'insufficient', 'rejected', 'invalidated']
      && linkedCompetitionAudit(request.resource.data.auditEventId,
        request.resource.data.status == 'evidence-verified' ? 'publish-competition-result'
          : request.resource.data.status == 'invalidated' ? 'invalidate-competition-result' : 'competition-review-outcome',
        submissionId);
    allow delete: if false;
  }
  match /verifiedPublicStandings/{submissionId} {
    allow get, list: if signedIn();
    allow create: if verifier() && validStanding(request.resource.data)
      && getAfter(competitionSubmissionPath(submissionId)).data.status == 'evidence-verified'
      && request.resource.data.eventId == getAfter(competitionSubmissionPath(submissionId)).data.eventId
      && request.resource.data.displayName == getAfter(competitionSubmissionPath(submissionId)).data.displayNameSnapshot
      && request.resource.data.exerciseName == getAfter(competitionSubmissionPath(submissionId)).data.exerciseName
      && request.resource.data.targetReps == getAfter(competitionSubmissionPath(submissionId)).data.targetReps
      && request.resource.data.loadKg == getAfter(competitionSubmissionPath(submissionId)).data.loadKg
      && activeCompetitionOptIn(getAfter(competitionSubmissionPath(submissionId)).data.ownerUid)
      && linkedCompetitionAudit(request.resource.data.auditEventId, 'publish-competition-result', submissionId);
    allow update: if false;
    allow delete: if signedIn() && ((exists(competitionSubmissionPath(submissionId))
        && get(competitionSubmissionPath(submissionId)).data.ownerUid == request.auth.uid
        && (getAfter(competitionSubmissionPath(submissionId)).data.status == 'withdrawn'
          || getAfter(/databases/$(database)/documents/publicCompetitionOptIns/$(request.auth.uid)).data.status == 'withdrawn'))
      || (verifier()
        && getAfter(competitionSubmissionPath(submissionId)).data.status == 'invalidated'
        && linkedCompetitionAudit(getAfter(competitionSubmissionPath(submissionId)).data.auditEventId, 'invalidate-competition-result', submissionId)));
  }
  match /competitionMetaSeasons/{seasonId} {
    allow get, list: if signedIn();
    allow create, update: if platformAdmin()
      && ((resource == null && request.resource.data.status == 'draft'
          && request.resource.data.createdByUid == request.auth.uid)
        || (resource != null
          && sameCreatedAt()
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && ((resource.data.status == 'draft' && request.resource.data.status == 'active'
              && getAfter(/databases/$(database)/documents/competitionMetaControl/current).data.activeSeasonId == seasonId)
            || (resource.data.status == 'active' && request.resource.data.status == 'finalizing'
              && getAfter(/databases/$(database)/documents/competitionMetaControl/current).data.activeSeasonId == null)
            || (resource.data.status == 'finalized' && request.resource.data.status == 'archived'))));
    allow delete: if false;
  }
  match /competitionMetaControl/current {
    allow get: if signedIn();
    allow list: if false;
    allow create, update: if platformAdmin()
      && ((resource == null && request.resource.data.activeSeasonId is string)
        || (resource != null
          && ((resource.data.activeSeasonId == null && request.resource.data.activeSeasonId is string)
            || (resource.data.activeSeasonId is string && request.resource.data.activeSeasonId == null))));
    allow delete: if false;
  }
  match /competitionMetaProjections/{projectionId} {
    allow get, list: if signedIn();
    allow create, update: if false;
    allow delete: if signedIn()
      && exists(/databases/$(database)/documents/athletes/$(request.auth.uid)/competitionMetaState/current)
      && get(/databases/$(database)/documents/athletes/$(request.auth.uid)/competitionMetaState/current).data.publicProjectionId == projectionId
      && getAfter(/databases/$(database)/documents/publicCompetitionOptIns/$(request.auth.uid)).data.status == 'withdrawn';
  }
  match /athletes/{uid}/{metaCollection}/{metaDocument} {
    allow get, list: if metaCollection in ['competitionMetaState', 'competitionMetaHistory']
      && (owner(uid) || platformAdmin());
    allow write: if false;
  }
  match /{metaAdminCollection}/{seasonId} {
    allow get, list: if metaAdminCollection in ['competitionMetaFinalizations', 'competitionMetaReconciliations']
      && platformAdmin();
    allow write: if false;
