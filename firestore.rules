rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner(uid) { return signedIn() && request.auth.uid == uid; }
  function validV1(data, contract) {
    return data.schemaVersion == 1 && data.contractVersion == contract;
  }
  function validTimestamps(data) {
    return data.createdAt is timestamp && data.updatedAt is timestamp;
  }
  function sameCreatedAt() { return request.resource.data.createdAt == resource.data.createdAt; }
  function sameOwnerUid() { return request.resource.data.ownerUid == resource.data.ownerUid; }
  function sameContract() { return request.resource.data.contractVersion == resource.data.contractVersion; }
  function sameSchema() { return request.resource.data.schemaVersion == resource.data.schemaVersion; }
  function advancesUpdatedAt() { return request.resource.data.updatedAt > resource.data.updatedAt; }
  function hasAnyOperatorRole(roles) {
    return signedIn()
      && request.auth.token.keys().hasAny(['optiformRoles'])
      && request.auth.token.optiformRoles is list
      && request.auth.token.optiformRoles.hasOnly(['platform-admin', 'moderator', 'support', 'verifier'])
      && request.auth.token.optiformRoles.hasAny(roles);
  }
  function hasOperatorRole(role) { return hasAnyOperatorRole([role]); }
  function platformAdmin() { return hasOperatorRole('platform-admin'); }
  function moderator() { return hasAnyOperatorRole(['platform-admin', 'moderator']); }
  function supportOperator() { return hasAnyOperatorRole(['platform-admin', 'support']); }
  function verifier() { return hasAnyOperatorRole(['platform-admin', 'verifier']); }
  function noSocialRestriction(uid) {
    return !exists(/databases/$(database)/documents/socialPublishingRestrictions/$(uid));
  }
  function canPublishSocial(uid) { return currentCommunityConsent(uid) && noSocialRestriction(uid); }
  function validOnboarding(data) {
    return data.keys().hasOnly(['completedAt', 'goal', 'experience', 'trainingLocation', 'equipment', 'frequency', 'sessionLength', 'majorLifts', 'movementPreferences', 'starterPath'])
      && data.completedAt is string
      && data.goal in ['muscle', 'strength', 'fat-loss', 'general-fitness', 'bodybuilding', 'powerlifting', 'endurance', 'athletic-performance']
      && data.experience in ['beginner', 'intermediate', 'advanced']
      && data.trainingLocation in ['commercial-gym', 'home-gym', 'bodyweight', 'limited-equipment']
      && data.equipment is list
      && data.frequency is int && data.frequency >= 1 && data.frequency <= 7
      && data.sessionLength in ['30-min', '45-min', '60-min', '75-min', '90-plus-min']
      && data.majorLifts is list && data.movementPreferences is list
      && data.starterPath in ['starter-plan', 'browse-programs', 'follow-creator', 'connect-coach'];
  }
  function validAthlete(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'ownerUid', 'onboarding', 'createdAt', 'updatedAt'])
      && data.schemaVersion == 1 && data.ownerUid == uid
      && validTimestamps(data)
      && validOnboarding(data.onboarding);
  }
  function validAthleteSettings(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'trainingLocation', 'equipment', 'units', 'rest', 'createdAt', 'updatedAt'])
      && validV1(data, 'athlete-settings-v1')
      && data.ownerUid == uid
      && data.trainingLocation in ['commercial-gym', 'home-gym', 'bodyweight', 'limited-equipment']
      && validSetupEquipment(data.equipment)
      && data.units is map && data.units.keys().hasOnly(['loadUnit', 'distanceSystem'])
      && data.units.loadUnit in ['kg', 'lb'] && data.units.distanceSystem in ['metric', 'imperial']
      && data.rest is map && data.rest.keys().hasOnly(['autoStart', 'overridesSeconds'])
      && data.rest.autoStart is bool && data.rest.overridesSeconds is map
      && data.rest.overridesSeconds.keys().hasOnly(['power', 'resistance', 'mixed', 'conditioning'])
      && (!data.rest.overridesSeconds.keys().hasAny(['power']) || validRestOverride(data.rest.overridesSeconds.power))
      && (!data.rest.overridesSeconds.keys().hasAny(['resistance']) || validRestOverride(data.rest.overridesSeconds.resistance))
      && (!data.rest.overridesSeconds.keys().hasAny(['mixed']) || validRestOverride(data.rest.overridesSeconds.mixed))
      && (!data.rest.overridesSeconds.keys().hasAny(['conditioning']) || validRestOverride(data.rest.overridesSeconds.conditioning))
      && validTimestamps(data);
  }
  function validLimitationProfile(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'excludedMovementPatterns', 'excludedSystemExerciseIds', 'createdAt', 'updatedAt'])
      && validV1(data, 'athlete-limitation-profile-v1') && data.ownerUid == uid
      && data.excludedMovementPatterns is list && data.excludedMovementPatterns.size() <= 14
      && data.excludedMovementPatterns.toSet().size() == data.excludedMovementPatterns.size()
      && data.excludedMovementPatterns.hasOnly(['horizontal-push', 'vertical-push', 'horizontal-pull', 'vertical-pull', 'squat', 'hinge', 'lunge', 'carry', 'integrated', 'rotation', 'anti-rotation', 'flexion-extension', 'isolation', 'locomotion-conditioning'])
      && data.excludedSystemExerciseIds is list && data.excludedSystemExerciseIds.size() <= 40
      && data.excludedSystemExerciseIds.toSet().size() == data.excludedSystemExerciseIds.size()
      && validTimestamps(data);
  }
  function validSetupEquipment(equipment) {
    return equipment is list && equipment.size() >= 1 && equipment.size() <= 35
      && equipment.toSet().size() == equipment.size()
      && equipment.hasOnly(['barbell', 'barbell-rack', 'dumbbells', 'kettlebells', 'machines', 'cables', 'bench', 'pull-up-bar', 'bands', 'cardio', 'treadmill', 'stationary-bike', 'air-bike', 'rowing-ergometer', 'ski-ergometer', 'elliptical', 'stair-climber', 'sled', 'jump-rope', 'battle-rope', 'medicine-ball', 'box-platform', 'ab-wheel', 'nordic-anchor', 'glute-ham-developer', 'slider', 'stability-ball', 'farmers-carry-handles', 'recumbent-bike', 'landmine', 'back-extension-station', 'reverse-hyper-machine', 'dip-station', 'weight-plate', 'bodyweight']);
  }
  function validEquipmentProfile(data, uid, profileId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'profileId', 'name', 'trainingLocation', 'equipment', 'createdAt', 'updatedAt'])
      && validV1(data, 'equipment-profiles-v1') && data.ownerUid == uid
      && data.profileId == profileId && profileId.size() >= 8 && profileId.size() <= 128
      && profileId.matches('^[A-Za-z0-9_-]+$')
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.name.matches('^\\S(?:.*\\S)?$')
      && data.trainingLocation in ['commercial-gym', 'home-gym', 'bodyweight', 'limited-equipment']
      && validSetupEquipment(data.equipment) && validTimestamps(data);
  }
  function validEquipmentProfileState(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'activeProfileId', 'profileIds', 'updatedAt'])
      && validV1(data, 'equipment-profile-state-v1') && data.ownerUid == uid
      && data.activeProfileId is string && data.activeProfileId.size() >= 8 && data.activeProfileId.size() <= 128
      && data.activeProfileId.matches('^[A-Za-z0-9_-]+$')
      && data.profileIds is list && data.profileIds.size() >= 1 && data.profileIds.size() <= 12
      && data.profileIds.toSet().size() == data.profileIds.size()
      && data.activeProfileId in data.profileIds && data.updatedAt is timestamp;
  }
  function effectiveSetupMatchesActive(data, uid) {
    let profile = getAfter(/databases/$(database)/documents/athletes/$(uid)/equipmentProfiles/$(data.activeProfileId)).data;
    let settings = getAfter(/databases/$(database)/documents/athletes/$(uid)/settings/current).data;
    return settings.trainingLocation == profile.trainingLocation && settings.equipment == profile.equipment;
  }
  function validEquipmentProfileStateTransition(data, uid) {
    let added = data.profileIds.removeAll(resource.data.profileIds);
    let removed = resource.data.profileIds.removeAll(data.profileIds);
    return (data.profileIds == resource.data.profileIds
        && existsAfter(/databases/$(database)/documents/athletes/$(uid)/equipmentProfiles/$(data.activeProfileId))
        && effectiveSetupMatchesActive(data, uid))
      || (data.profileIds.size() == resource.data.profileIds.size() + 1
        && added.size() == 1 && removed.size() == 0
        && data.activeProfileId == resource.data.activeProfileId
        && existsAfter(/databases/$(database)/documents/athletes/$(uid)/equipmentProfiles/$(added[0])))
      || (data.profileIds.size() == resource.data.profileIds.size() - 1
        && added.size() == 0 && removed.size() == 1
        && data.activeProfileId == resource.data.activeProfileId
        && !existsAfter(/databases/$(database)/documents/athletes/$(uid)/equipmentProfiles/$(removed[0])));
  }
  function validRestOverride(value) {
    return value is int && value >= 30 && value <= 600 && value % 30 == 0;
  }
  function validNativeWorkoutPreferences(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'hapticsEnabled', 'keepAwakeEnabled', 'restNotificationsEnabled', 'createdAt', 'updatedAt'])
      && data.schemaVersion == 1
      && data.contractVersion == 'native-workout-integrations-v1'
      && data.ownerUid == uid
      && data.hapticsEnabled is bool
      && data.keepAwakeEnabled is bool
      && data.restNotificationsEnabled is bool
      && validTimestamps(data);
  }
  function validCompletedWorkout(data, uid, workoutId) {
    return ((data.schemaVersion == 1
      && data.keys().hasOnly(['schemaVersion', 'recordOrigin', 'sourceSessionSchemaVersion', 'workoutId', 'ownerUid', 'startedAt', 'completedAt', 'note', 'exercises'])
      && data.sourceSessionSchemaVersion == 3)
      || (data.schemaVersion == 2
      && data.keys().hasOnly(['schemaVersion', 'recordOrigin', 'sourceSessionSchemaVersion', 'workoutId', 'ownerUid', 'startedAt', 'completedAt', 'pausedDurationSeconds', 'groups', 'note', 'exercises'])
      && data.sourceSessionSchemaVersion == 4
      && data.pausedDurationSeconds is int && data.pausedDurationSeconds >= 0
      && data.groups is list)
      || (data.schemaVersion == 3
      && data.keys().hasOnly(['schemaVersion', 'recordOrigin', 'sourceSessionSchemaVersion', 'workoutId', 'ownerUid', 'startedAt', 'completedAt', 'pausedDurationSeconds', 'groups', 'note', 'exercises', 'programContext'])
      && data.sourceSessionSchemaVersion == 5
      && data.pausedDurationSeconds is int && data.pausedDurationSeconds >= 0
      && data.groups is list
      && (!data.keys().hasAny(['programContext']) || validAnyProgramContext(data.programContext))))
      && data.recordOrigin == 'athlete-client'
      && data.workoutId == workoutId
      && data.ownerUid == uid
      && data.startedAt is timestamp
      && data.completedAt is timestamp
      && data.completedAt >= data.startedAt
      && data.exercises is list
      && data.exercises.size() > 0
      && (!data.keys().hasAny(['note']) || data.note is string);
  }
  function validProgramContext(data) {
    return data is map
      && data.keys().hasOnly(['contractVersion', 'enrollmentId', 'programSource', 'programId', 'programVersionId', 'programName', 'sessionLabel', 'weekNumber', 'dayOfWeek', 'sessionKey', 'scheduledDateLocal'])
      && data.contractVersion == 'workout-program-provenance-v1'
      && data.enrollmentId.matches('^enrollment-[A-Za-z0-9-]+$')
      && data.programSource in ['athlete', 'optiform-system']
      && data.programId.matches('^program-[A-Za-z0-9-]+$')
      && data.programVersionId.matches('^v[0-9]+$')
      && data.programName is string && data.programName.size() >= 1 && data.programName.size() <= 80
      && data.sessionLabel is string && data.sessionLabel.size() >= 1 && data.sessionLabel.size() <= 80
      && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52
      && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
      && data.sessionKey == 'w' + string(data.weekNumber) + '-d' + string(data.dayOfWeek)
      && data.scheduledDateLocal is string;
  }
  function validCreatorProgramContext(data) {
    return data is map
      && data.keys().hasOnly(['contractVersion', 'programSource', 'enrollmentId', 'listingId', 'creatorId', 'publicationVersionId', 'deliveryDayId', 'programName', 'sessionLabel', 'weekNumber', 'dayOfWeek', 'sessionKey', 'scheduledDateLocal'])
      && data.contractVersion == 'workout-program-provenance-v2'
      && data.programSource == 'creator-entitled'
      && data.enrollmentId.matches('^creator-enrollment-[A-Za-z0-9-]+$')
      && data.listingId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.creatorId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.publicationVersionId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.deliveryDayId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.programName is string && data.programName.size() >= 1 && data.programName.size() <= 80
      && data.sessionLabel is string && data.sessionLabel.size() >= 1 && data.sessionLabel.size() <= 80
      && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52
      && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
      && data.sessionKey == 'w' + string(data.weekNumber) + '-d' + string(data.dayOfWeek)
      && data.scheduledDateLocal is string
      && data.scheduledDateLocal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
  }
  function validAnyProgramContext(data) {
    return validProgramContext(data) || validCreatorProgramContext(data) || validGymProgramContext(data);
  }
  function validGymProgramContext(data) {
    return data is map
      && data.keys().hasOnly(['contractVersion', 'programSource', 'enrollmentId', 'gymId', 'gymProgramId', 'publicationVersionId', 'deliveryDayId', 'programName', 'sessionLabel', 'weekNumber', 'dayOfWeek', 'sessionKey', 'scheduledDateLocal'])
      && data.contractVersion == 'workout-program-provenance-v3'
      && data.programSource == 'gym-program'
      && data.enrollmentId.matches('^gym-program-enrollment-[A-Za-z0-9-]+$')
      && data.gymId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.gymProgramId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.publicationVersionId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.deliveryDayId.matches('^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$')
      && data.programName is string && data.programName.size() >= 1 && data.programName.size() <= 80
      && data.sessionLabel is string && data.sessionLabel.size() >= 1 && data.sessionLabel.size() <= 80
      && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52
      && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
      && data.sessionKey == 'w' + string(data.weekNumber) + '-d' + string(data.dayOfWeek)
      && data.scheduledDateLocal is string
      && data.scheduledDateLocal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
  }
  function creatorWorkoutCreateAuthorized(data, uid, workoutId) {
    let context = data.programContext;
    let permit = get(/databases/$(database)/documents/creatorProgramExecutionPermits/$(uid)/permits/$(workoutId)).data;
    let listing = get(/databases/$(database)/documents/creatorPublicListings/$(context.listingId)).data;
    let profile = get(/databases/$(database)/documents/creatorPublicProfiles/$(context.creatorId)).data;
    return permit.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'workoutId', 'enrollmentId', 'listingId', 'creatorId', 'publicationVersionId', 'contentHash', 'deliveryDayId', 'programName', 'sessionLabel', 'weekNumber', 'dayOfWeek', 'sessionKey', 'scheduledDateLocal', 'firstIssuedAt', 'lastAuthorizedAt', 'expiresAt', 'revision'])
      && permit.schemaVersion == 1
      && permit.contractVersion == 'creator-program-execution-permit-v1'
      && permit.ownerUid == uid && permit.workoutId == workoutId
      && permit.enrollmentId == context.enrollmentId && permit.listingId == context.listingId
      && permit.creatorId == context.creatorId
      && permit.publicationVersionId == context.publicationVersionId
      && permit.deliveryDayId == context.deliveryDayId
      && permit.programName == context.programName && permit.sessionLabel == context.sessionLabel
      && permit.weekNumber == context.weekNumber && permit.dayOfWeek == context.dayOfWeek
      && permit.sessionKey == context.sessionKey
      && permit.scheduledDateLocal == context.scheduledDateLocal
      && permit.contentHash is string && permit.contentHash.matches('^[a-f0-9]{64}$')
      && permit.firstIssuedAt is timestamp && permit.lastAuthorizedAt is timestamp
      && permit.expiresAt is timestamp && permit.expiresAt >= request.time
      && permit.revision is int && permit.revision >= 1
      && listing.creatorId == context.creatorId && listing.platformStatus == 'active'
      && profile.creatorId == context.creatorId && profile.platformStatus == 'active';
  }
  function completedWorkoutCreateAuthorized(data, uid, workoutId) {
    return !data.keys().hasAny(['programContext'])
      || data.programContext.contractVersion == 'workout-program-provenance-v1'
      || (validCreatorProgramContext(data.programContext)
        && creatorWorkoutCreateAuthorized(data, uid, workoutId))
      || (validGymProgramContext(data.programContext)
        && gymWorkoutCreateAuthorized(data, uid, workoutId));
  }
  function gymWorkoutCreateAuthorized(data, uid, workoutId) {
    let context = data.programContext;
    let permit = get(/databases/$(database)/documents/gymProgramExecutionPermits/$(uid)/permits/$(workoutId)).data;
    let gym = get(/databases/$(database)/documents/gymBusinessProfiles/$(context.gymId)).data;
    return permit.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'workoutId', 'enrollmentId', 'gymId', 'gymProgramId', 'publicationVersionId', 'contentHash', 'deliveryDayId', 'programName', 'sessionLabel', 'weekNumber', 'dayOfWeek', 'sessionKey', 'scheduledDateLocal', 'firstIssuedAt', 'lastAuthorizedAt', 'expiresAt', 'revision'])
      && permit.schemaVersion == 1
      && permit.contractVersion == 'gym-program-execution-permit-v1'
      && permit.ownerUid == uid && permit.workoutId == workoutId
      && permit.enrollmentId == context.enrollmentId && permit.gymId == context.gymId
      && permit.gymProgramId == context.gymProgramId
      && permit.publicationVersionId == context.publicationVersionId
      && permit.deliveryDayId == context.deliveryDayId
      && permit.programName == context.programName && permit.sessionLabel == context.sessionLabel
      && permit.weekNumber == context.weekNumber && permit.dayOfWeek == context.dayOfWeek
      && permit.sessionKey == context.sessionKey
      && permit.scheduledDateLocal == context.scheduledDateLocal
      && permit.contentHash is string && permit.contentHash.matches('^[a-f0-9]{64}$')
      && permit.firstIssuedAt is timestamp && permit.lastAuthorizedAt is timestamp
      && permit.expiresAt is timestamp && permit.expiresAt >= request.time
      && permit.revision is int && permit.revision >= 1
      && gym.gymId == context.gymId && gym.status == 'active' && gym.platformStatus == 'active';
  }
  function validProgramIndex(data, uid, programId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'programId', 'source', 'name', 'currentVersionId', 'currentVersionNumber', 'status', 'createdAt', 'updatedAt'])
      && validV1(data, 'training-programs-v1')
      && data.ownerUid == uid && data.programId == programId && programId.matches('^program-[A-Za-z0-9-]+$')
      && data.source == 'athlete' && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.currentVersionNumber is int && data.currentVersionNumber >= 1
      && data.currentVersionId == 'v' + string(data.currentVersionNumber)
      && data.status in ['active', 'archived'] && validTimestamps(data);
  }
  function validProgramVersion(data, uid, programId, versionId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'programId', 'versionId', 'versionNumber', 'name', 'description', 'note', 'durationWeeks', 'createdAt'])
      && validV1(data, 'training-programs-v1')
      && data.ownerUid == uid && data.programId == programId && data.versionId == versionId
      && data.versionNumber is int && data.versionNumber >= 1 && versionId == 'v' + string(data.versionNumber)
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.durationWeeks is int && data.durationWeeks >= 1 && data.durationWeeks <= 52
      && (!data.keys().hasAny(['description']) || (data.description is string && data.description.size() <= 1000))
      && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 1000))
      && data.createdAt is timestamp;
  }
  function validProgramDay(data, uid, programId, versionId, dayId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'programId', 'versionId', 'dayId', 'weekNumber', 'dayOfWeek', 'weekKind', 'label', 'note', 'exercises', 'groups', 'createdAt'])
      && validV1(data, 'training-programs-v1')
      && data.ownerUid == uid && data.programId == programId && data.versionId == versionId && data.dayId == dayId
      && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52
      && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
      && dayId == 'w' + string(data.weekNumber) + '-d' + string(data.dayOfWeek)
      && data.weekKind in ['standard', 'deload'] && data.label is string && data.label.size() >= 1 && data.label.size() <= 80
      && (!data.keys().hasAny(['note']) || (data.note is string && data.note.size() <= 1000))
      && data.exercises is list && data.exercises.size() <= 20 && data.groups is list && data.groups.size() <= 20
      && data.createdAt is timestamp;
  }
  function validEnrollment(data, uid, enrollmentId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'enrollmentId', 'programSource', 'programId', 'startDateLocal', 'status', 'versionAssignments', 'createdAt', 'updatedAt'])
      && validV1(data, 'program-enrollment-v1')
      && data.ownerUid == uid && data.enrollmentId == enrollmentId && enrollmentId.matches('^enrollment-[A-Za-z0-9-]+$')
      && data.programSource in ['athlete', 'optiform-system'] && data.programId.matches('^program-[A-Za-z0-9-]+$')
      && data.startDateLocal is string && data.status in ['active', 'completed', 'cancelled']
      && data.versionAssignments is list && data.versionAssignments.size() >= 1 && data.versionAssignments.size() <= 52
      && validTimestamps(data);
  }
  function validProgramState(data, uid) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'activeEnrollmentId', 'createdAt', 'updatedAt'])
      && validV1(data, 'program-enrollment-v1') && data.ownerUid == uid
      && (data.activeEnrollmentId == null || data.activeEnrollmentId.matches('^enrollment-[A-Za-z0-9-]+$'))
      && validTimestamps(data);
  }
  function validProgramSkip(data, uid, enrollmentId, sessionKey) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'enrollmentId', 'sessionKey', 'kind', 'programId', 'versionId', 'weekNumber', 'dayOfWeek', 'scheduledDateLocal', 'createdAt'])
      && validV1(data, 'program-enrollment-v1') && data.ownerUid == uid
      && data.enrollmentId == enrollmentId && data.sessionKey == sessionKey && data.kind == 'skipped'
      && data.weekNumber is int && data.weekNumber >= 1 && data.weekNumber <= 52
      && data.dayOfWeek is int && data.dayOfWeek >= 1 && data.dayOfWeek <= 7
      && sessionKey == 'w' + string(data.weekNumber) + '-d' + string(data.dayOfWeek)
      && data.programId.matches('^program-[A-Za-z0-9-]+$') && data.versionId.matches('^v[0-9]+$')
      && data.scheduledDateLocal is string && data.createdAt is timestamp;
  }
  function validCustomExercise(data, uid, exerciseId) {
    return data.keys().hasOnly(['schemaVersion', 'contractVersion', 'ownerUid', 'exerciseId', 'name', 'trackingProfile', 'trainingClassification', 'equipment', 'createdAt', 'updatedAt'])
      && validV1(data, 'athlete-custom-exercise-v1')
      && data.ownerUid == uid && data.exerciseId == exerciseId
      && exerciseId.matches('^custom-[A-Za-z0-9-]+$')
      && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
      && data.trackingProfile is map
      && data.trackingProfile.keys().hasOnly(['primaryMetric', 'supportedMetrics'])
      && data.trackingProfile.primaryMetric in ['reps', 'load', 'time', 'distance', 'pace', 'rounds']
      && data.trackingProfile.supportedMetrics is list
      && data.trackingProfile.supportedMetrics.size() >= 1 && data.trackingProfile.supportedMetrics.size() <= 6
      && data.trackingProfile.supportedMetrics.toSet().size() == data.trackingProfile.supportedMetrics.size()
      && data.trackingProfile.supportedMetrics.hasOnly(['reps', 'load', 'time', 'distance', 'pace', 'rounds'])
      && data.trackingProfile.primaryMetric in data.trackingProfile.supportedMetrics
      && data.trainingClassification in ['resistance', 'conditioning', 'power', 'mixed']
      && data.equipment is list && data.equipment.size() <= 12
      && data.equipment.toSet().size() == data.equipment.size()
